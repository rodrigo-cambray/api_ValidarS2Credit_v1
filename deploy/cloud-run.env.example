# Copy to deploy/cloud-run.env, replace every value, then Base64-encode that file.
# Never commit deploy/cloud-run.env. Cloud Run injects PORT; do not add PORT here.
MYSQL_HOST=database-host.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=credit_assessment
MYSQL_USER=cloud_run_service
MYSQL_PASSWORD=replace-with-a-secret
BEARER_TOKEN=replace-with-a-long-random-secret
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database
